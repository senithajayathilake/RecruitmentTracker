@model HiringManagerDashboardViewModel
@{
    ViewData["Title"] = "Hiring Manager Dashboard";
}
<div class="container py-4">
    <div class="page-heading">
        <div><span class="eyebrow">HIRING MANAGER</span><h1>Hiring manager dashboard</h1><p>Review evidence, compare candidates and make hiring decisions.</p></div>
        <div class="d-flex gap-2">
            <a asp-controller="Comparison" asp-action="Index" class="btn btn-outline-primary">Compare candidates</a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-primary">Reports</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="stat-card"><span>Open vacancies</span><strong>@Model.OpenVacancies</strong><i class="bi bi-briefcase"></i></div></div>
        <div class="col-md-3"><div class="stat-card"><span>Pending decisions</span><strong>@Model.PendingDecisions</strong><i class="bi bi-hourglass-split"></i></div></div>
        <div class="col-md-3"><div class="stat-card"><span>Completed interviews</span><strong>@Model.CompletedInterviews</strong><i class="bi bi-chat-square-check"></i></div></div>
        <div class="col-md-3"><div class="stat-card"><span>Hired</span><strong>@Model.HiredCount</strong><i class="bi bi-person-check"></i></div></div>
    </div>

    <div class="content-card">
        <div class="d-flex justify-content-between mb-3"><h5>Candidate applications</h5><span class="badge text-bg-primary">@Model.Applications.Count applications</span></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Candidate</th><th>Vacancy</th><th>AI Match</th><th>Current stage</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var app in Model.Applications)
                {
                    <tr>
                        <td><strong>@app.Candidate?.FullName</strong><br><small>@app.Candidate?.Email</small></td>
                        <td>@app.Vacancy?.JobTitle</td>
                        <td><span class="score">@((app.AiScore ?? 0).ToString("0.0"))%</span></td>
                        <td>@(app.CurrentInterviewStage?.StageName ?? "Not started")</td>
                        <td><span class="badge text-bg-secondary">@app.Status</span></td>
                        <td><a asp-controller="Application" asp-action="Details" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-light">Review</a></td>
                    </tr>
                }
                @if (!Model.Applications.Any())
                {
                    <tr><td colspan="6" class="text-secondary">No applications available yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
