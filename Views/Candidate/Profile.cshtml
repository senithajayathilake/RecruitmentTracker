@model Candidate

@{
    ViewData["Title"] = "My Profile";

    var initial =
        string.IsNullOrWhiteSpace(Model.FullName)
            ? "?"
            : Model.FullName.Trim()
                .Substring(0, 1)
                .ToUpper();

    var avatarUrl =
        Url.Action(
            "Avatar",
            "Candidate",
            new
            {
                id = Model.CandidateId
            });
}

<div class="container py-4">

    <div class="page-heading">

        <div>

            <span class="eyebrow">
                CANDIDATE
            </span>

            <h1>
                My profile
            </h1>

            <p>
                Keep your recruitment profile and profile image up to date.
            </p>

        </div>

    </div>


    <div class="content-card">

        <form asp-action="Profile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- PROFILE IMAGE -->

            <div class="candidate-profile-photo-section">

                <div class="candidate-avatar candidate-avatar-xl">

                    <span class="candidate-avatar-fallback">
                        @initial
                    </span>

                    <img class="candidate-avatar-image"
                         src="@avatarUrl"
                         alt="@Model.FullName profile image"
                         onerror="this.style.display='none';" />

                </div>


                <div class="candidate-photo-controls">

                    <h5>
                        Profile picture
                    </h5>

                    <p class="text-secondary mb-3">
                        Upload a professional candidate profile image.
                    </p>


                    <input type="file"
                           name="avatar"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,image/jpeg,image/png" />


                    <small class="text-secondary d-block mt-2">
                        JPG, JPEG or PNG · Maximum 2 MB
                    </small>

                </div>

            </div>


            <hr class="my-4" />


            <div class="row g-3">


                <div class="col-md-6">

                    <label asp-for="FullName"
                           class="form-label">
                    </label>

                    <input asp-for="FullName"
                           class="form-control" />

                    <span asp-validation-for="FullName"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Email
                    </label>

                    <input value="@Model.Email"
                           class="form-control"
                           disabled />

                </div>


                <div class="col-md-6">

                    <label asp-for="Phone"
                           class="form-label">
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                    <span asp-validation-for="Phone"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="DateOfBirth"
                           class="form-label">
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DateOfBirth"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="HighestQualification"
                           class="form-label">
                    </label>

                    <input asp-for="HighestQualification"
                           class="form-control" />

                    <span asp-validation-for="HighestQualification"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="YearsOfExperience"
                           class="form-label">
                    </label>

                    <input asp-for="YearsOfExperience"
                           class="form-control" />

                    <span asp-validation-for="YearsOfExperience"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-12">

                    <label asp-for="Address"
                           class="form-label">
                    </label>

                    <input asp-for="Address"
                           class="form-control" />

                    <span asp-validation-for="Address"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-12">

                    <label asp-for="Skills"
                           class="form-label">
                    </label>

                    <textarea asp-for="Skills"
                              class="form-control"
                              rows="3"
                              placeholder="C#, .NET, SQL, Git"></textarea>

                    <span asp-validation-for="Skills"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <button type="submit"
                    class="btn btn-primary mt-4">

                <i class="bi bi-check-lg me-2"></i>

                Save profile

            </button>

        </form>

    </div>

</div>