@model Candidate
@{
    ViewData["Title"] = "My Profile";
}
<div class="container py-4">
    <div class="page-heading"><div><span class="eyebrow">CANDIDATE</span><h1>My profile</h1><p>Keep your recruitment profile up to date.</p></div></div>
    <div class="content-card">
        <form asp-action="Profile" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Email</label><input value="@Model.Email" class="form-control" disabled /></div>
                <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="HighestQualification" class="form-label"></label><input asp-for="HighestQualification" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="YearsOfExperience" class="form-label"></label><input asp-for="YearsOfExperience" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                <div class="col-12"><label asp-for="Skills" class="form-label"></label><textarea asp-for="Skills" class="form-control" rows="3" placeholder="C#, .NET, SQL, Git"></textarea></div>
            </div>
            <button class="btn btn-primary mt-4">Save profile</button>
        </form>
    </div>
</div>
