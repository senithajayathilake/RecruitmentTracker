@model Candidate
@{
    ViewData["Title"] = "Add Candidate";
}
<div class="container py-4">
    <div class="page-heading"><div><span class="eyebrow">PB05</span><h1>Add candidate</h1><p>Create a candidate record before uploading their CV.</p></div></div>
    <div class="content-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="HighestQualification" class="form-label"></label><input asp-for="HighestQualification" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="YearsOfExperience" class="form-label"></label><input asp-for="YearsOfExperience" class="form-control" /></div>
                <div class="col-12"><label asp-for="Skills" class="form-label"></label><textarea asp-for="Skills" class="form-control" placeholder="Python, C#, SQL, Machine Learning"></textarea></div>
            </div>
            <button class="btn btn-primary mt-4">Add candidate</button>
        </form>
    </div>
</div>
