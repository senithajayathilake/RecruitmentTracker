<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Higher Flow Careers</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="public-body">

    <div class="public-grid" aria-hidden="true"></div>


    <header class="public-header">

        <div class="public-nav-shell">

            <a class="public-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="public-brand-mark">
                    H
                </span>

                <span class="public-brand-copy">

                    <strong>
                        HIGHER FLOW
                    </strong>

                    <small>
                        Careers
                    </small>

                </span>

            </a>


            <nav class="public-nav-links"
                 aria-label="Main navigation">

                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index">

                    Home

                </a>


                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Opportunities" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Opportunities">

                    Opportunities

                </a>


                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="About">

                    About

                </a>


                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Contact">

                    Contact

                </a>

            </nav>


            <div class="public-staff-area">

                <span class="public-platform-label">
                    RECRUITMENT PLATFORM
                </span>


                <a class="public-login-switch"
                   asp-controller="Account"
                   asp-action="Login">

                    <span class="public-switch-track">

                        <span class="public-switch-knob"></span>

                    </span>

                    <span>
                        STAFF LOGIN
                    </span>

                </a>

            </div>

        </div>

    </header>


    <main class="public-main">

        @RenderBody()

    </main>


    <footer class="public-footer">

        <div class="public-footer-inner">

            <div class="public-footer-brand">

                <span class="footer-mark">
                    H
                </span>

                <span>

                    <strong>
                        Higher Flow
                    </strong>

                    <small>
                        Recruitment & careers
                    </small>

                </span>

            </div>


            <div class="public-footer-links">

                <a asp-controller="Home"
                   asp-action="Opportunities">

                    Opportunities

                </a>


                <a asp-controller="Home"
                   asp-action="About">

                    About

                </a>


                <a asp-controller="Home"
                   asp-action="Contact">

                    Contact

                </a>

            </div>


            <small>
                &copy; @DateTime.Now.Year Higher Flow
            </small>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync("Scripts", required: false)


    <!-- HIREFLOW CHATBOT -->
    @await Html.PartialAsync("_Chatbot")


</body>
</html>