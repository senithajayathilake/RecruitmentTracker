<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Higher Flow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-people-fill me-2"></i>Higher Flow

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav"
                    aria-controls="mainNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="HR">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Vacancy"
                                   asp-action="Index">
                                    Vacancies
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Candidate"
                                   asp-action="Index">
                                    Candidates
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CandidateFilter"
                                   asp-action="Index">
                                    AI Screening
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="RoleManagement"
                                   asp-action="Index">
                                    Manage Roles
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Candidate">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Vacancy"
                                   asp-action="Browse">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Candidate"
                                   asp-action="Profile">
                                    Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="CV"
                                   asp-action="Upload">
                                    Upload CV
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Interviewer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Interviewer">
                                    Dashboard
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("HiringManager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Manager">
                                    Dashboard
                                </a>
                            </li>
                        }

                        <li class="nav-item ms-lg-3">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">
                                    Logout
                                </button>

                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Account"
                               asp-action="Register">
                                Candidate Sign Up
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>

    </nav>
</header>


<main>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">

            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">

            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        </div>
    }


    @RenderBody()

</main>


<footer class="border-top mt-5 py-4">

    <div class="container text-muted small">

        <strong>Higher Flow</strong>
        &copy; @DateTime.Now.Year

    </div>

</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>