
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Higher Flow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        var isHomePage =
            controller == "Home" &&
            action == "Index";

        var isAuthPage =
            controller == "Account" &&
            (action == "Login" || action == "Register");

        var hideNavbar = isHomePage || isAuthPage;
    }


    @* =====================================================
       NAVBAR
       Hidden on Home, Login and Register pages
       ===================================================== *@

    @if (!hideNavbar)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
                <div class="container">

                    <a class="navbar-brand fw-bold"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-people-fill me-2"></i>
                        Higher Flow

                    </a>


                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNav"
                            aria-controls="mainNav"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <div class="collapse navbar-collapse" id="mainNav">

                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @* =========================
                                   HR
                                   ========================= *@

                                if (User.IsInRole("HR"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Dashboard"
                                           asp-action="HR">
                                            Dashboard
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Vacancy"
                                           asp-action="Index">
                                            Vacancies
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="CandidateFilter"
                                           asp-action="Index">
                                            AI Screening
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="RoleManagement"
                                           asp-action="Index">
                                            Manage Roles
                                        </a>
                                    </li>
                                }


                                @* =========================
                                   CANDIDATE
                                   ========================= *@

                                else if (User.IsInRole("Candidate"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Dashboard"
                                           asp-action="Candidate">
                                            Dashboard
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Vacancy"
                                           asp-action="Browse">
                                            Jobs
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Candidate"
                                           asp-action="Profile">
                                            Profile
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="CV"
                                           asp-action="Upload">
                                            Upload CV
                                        </a>
                                    </li>
                                }


                                @* =========================
                                   INTERVIEWER
                                   ========================= *@

                                else if (User.IsInRole("Interviewer"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Dashboard"
                                           asp-action="Interviewer">
                                            Dashboard
                                        </a>
                                    </li>
                                }


                                @* =========================
                                   HIRING MANAGER
                                   ========================= *@

                                else if (User.IsInRole("HiringManager"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Dashboard"
                                           asp-action="Manager">
                                            Dashboard
                                        </a>
                                    </li>
                                }


                                @* =========================
                                   LOGOUT
                                   ========================= *@

                                <li class="nav-item ms-lg-3">

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-light btn-sm px-3">

                                            <i class="bi bi-box-arrow-right me-1"></i>
                                            Logout

                                        </button>

                                    </form>

                                </li>
                            }

                        </ul>

                    </div>

                </div>
            </nav>
        </header>
    }


    <main>

        @* =====================================================
           SUCCESS MESSAGE
           ===================================================== *@

        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">

                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle me-2"></i>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>

            </div>
        }


        @* =====================================================
           ERROR MESSAGE
           ===================================================== *@

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">

                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>

                </div>

            </div>
        }


        @RenderBody()

    </main>


    @* =====================================================
       FOOTER
       Hidden on Home, Login and Register
       ===================================================== *@

    @if (!hideNavbar)
    {
        <footer class="hf-footer">

            <div class="container text-muted small">

                <i class="bi bi-people-fill me-1"></i>

                <strong>Higher Flow</strong>

                <span class="mx-1">•</span>

                &copy; @DateTime.Now.Year

            </div>

        </footer>
    }


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

