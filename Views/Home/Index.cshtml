@{
    ViewData["Title"] = "Careers";
}

<section class="career-portal">
    <div class="career-grid"></div>

    <header class="career-topbar">
        <a class="career-brand" asp-controller="Home" asp-action="Index">
            <span class="career-brand-mark">H</span>
            <span class="career-brand-copy">
                <strong>HIGHER FLOW</strong>
                <small>Careers</small>
            </span>
        </a>
        <div class="career-top-actions">
            <span class="career-portal-label">RECRUITMENT PLATFORM</span>
            <a asp-controller="Account" asp-action="Login" class="career-test-pill">
                <span class="career-toggle-dot"></span>
                STAFF LOGIN
            </a>
        </div>
    </header>

    <div class="career-shell">
        <div class="career-copy">
            <div class="career-kicker"><span></span> BUILD WHAT MATTERS</div>
            <h1>Find your next<br /><em>opportunity.</em></h1>
            <p>Join a team that values clear thinking, meaningful work, and the people behind every idea.</p>

            <div class="career-values">
                <div><b>01</b><span>PURPOSE-LED<br />WORK</span></div>
                <div><b>02</b><span>ROOM TO<br />GROW</span></div>
                <div><b>03</b><span>PEOPLE<br />FIRST</span></div>
            </div>
        </div>

        <div class="career-action-card">
            <span class="career-card-kicker">APPLICATION</span>
            <h2>Start your application</h2>
            <p>Browse open roles, create your candidate profile and share your CV. It only takes a few minutes.</p>

            <div class="career-card-block">
                <label>Looking for an opportunity?</label>
                <a asp-controller="Account" asp-action="Register" class="btn career-primary-btn w-100">
                    Create candidate account <i class="bi bi-arrow-up-right ms-2"></i>
                </a>
            </div>

            <div class="career-divider"><span>or</span></div>

            <a asp-controller="Account" asp-action="Login" class="btn career-secondary-btn w-100">
                Sign in to your account
            </a>

            <div class="career-card-footer">
                <i class="bi bi-shield-check"></i>
                Your information is only accessible to the recruitment team.
            </div>
        </div>
    </div>
</section>
