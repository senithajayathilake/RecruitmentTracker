@{
    ViewData["Title"] = "Home";
}

<section class="hf-home">

    <div class="hf-left">

        <div class="hf-content">

            <div class="hf-logo">
                <div class="hf-logo-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <span>Higher Flow</span>
            </div>

            <div class="hf-welcome">

                <span class="hf-eyebrow">
                    RECRUITMENT MANAGEMENT
                </span>

                <h1>
                    Build your team.<br />
                    <span>Better.</span>
                </h1>

                <p>
                    A simple and smarter way to manage vacancies,
                    candidates and the recruitment process.
                </p>

                <div class="hf-buttons">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn hf-btn-primary">

                        Sign in

                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn hf-btn-secondary">

                        Candidate Sign Up

                    </a>

                </div>

            </div>

            <div class="hf-footer-text">
                Recruitment made simple.
            </div>

        </div>

    </div>


    <div class="hf-right">

        <div class="hf-shape hf-shape-one"></div>

        <div class="hf-shape hf-shape-two"></div>

        <div class="hf-shape hf-shape-three"></div>

        <div class="hf-blue-content">

            <div class="hf-blue-circle">
                <i class="bi bi-person-check"></i>
            </div>

            <h2>
                Smarter hiring.<br />
                Better teams.
            </h2>

            <p>
                Connect candidates with opportunities
                and make recruitment easier.
            </p>

        </div>

    </div>

</section>