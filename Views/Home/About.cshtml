@{
    ViewData["Title"] = "About";
    Layout = "_PublicLayout";
}

<section class="public-page-hero compact">
    <div class="public-kicker"><span></span>ABOUT HIGHER FLOW</div>
    <h1>Hiring should feel <em>clear, fair and human.</em></h1>
    <p>Higher Flow brings vacancies, candidates, interview stages, feedback and hiring decisions into one transparent recruitment workflow.</p>
</section>

<section class="public-content-grid three">
    <article class="public-info-card">
        <span class="info-number">01</span>
        <h3>Clear process</h3>
        <p>Every candidate has a visible stage, every vacancy has a defined workflow, and the recruitment team has one shared source of truth.</p>
    </article>
    <article class="public-info-card">
        <span class="info-number">02</span>
        <h3>Fair evaluation</h3>
        <p>Structured interviewer feedback and consistent scoring make it easier to compare candidates using the same criteria.</p>
    </article>
    <article class="public-info-card">
        <span class="info-number">03</span>
        <h3>Better oversight</h3>
        <p>Dashboards, interview tracking and management reports help teams understand what is happening across the recruitment pipeline.</p>
    </article>
</section>

<section class="public-split-section">
    <div>
        <div class="public-kicker"><span></span>DESIGNED FOR THE WHOLE TEAM</div>
        <h2>One platform, different responsibilities.</h2>
        <p>Recruiters manage vacancies and candidates, interviewers focus on the interviews assigned to them, candidates track their own progress, and management gets the oversight needed to make informed decisions.</p>
    </div>
    <div class="role-stack">
        <div><strong>HR / Recruiters</strong><span>Positions, candidates, stages and hiring decisions</span></div>
        <div><strong>Interviewers</strong><span>Assigned interviews and structured feedback</span></div>
        <div><strong>Candidates</strong><span>Profile, CV, applications and interview updates</span></div>
        <div><strong>Management</strong><span>Comparison, reports and recruitment oversight</span></div>
    </div>
</section>
