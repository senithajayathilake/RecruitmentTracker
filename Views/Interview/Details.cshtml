@model Interview
@{
    ViewData["Title"] = "Interview Details";
}
<div class="container py-4">
    <div class="page-heading">
        <div>
            <span class="eyebrow">INTERVIEW</span>
            <h1>@Model.InterviewStage?.StageName</h1>
            <p>@Model.Application?.Candidate?.FullName · @Model.Application?.Vacancy?.JobTitle</p>
        </div>
        <span class="badge text-bg-secondary">@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="content-card">
                <h5>Interview details</h5>
                <div class="pipeline-row"><span>Candidate</span><strong>@Model.Application?.Candidate?.FullName</strong></div>
                <div class="pipeline-row"><span>Vacancy</span><strong>@Model.Application?.Vacancy?.JobTitle</strong></div>
                <div class="pipeline-row"><span>Stage</span><strong>@Model.InterviewStage?.StageName</strong></div>
                <div class="pipeline-row"><span>Interviewer</span><strong>@Model.Interviewer?.FullName</strong></div>
                <div class="pipeline-row"><span>Date / time</span><strong>@Model.ScheduledAt.ToString("dd MMM yyyy HH:mm")</strong></div>
                <div class="pipeline-row"><span>Duration</span><strong>@Model.DurationMinutes minutes</strong></div>
                <div class="pipeline-row"><span>Location / link</span><strong>@Model.LocationOrMeetingLink</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3"><strong>Notes</strong><p class="text-secondary mb-0 mt-1">@Model.Notes</p></div>
                }

                <div class="d-flex gap-2 mt-4">
                    @if (User.IsInRole("Interviewer") && Model.Status != "Cancelled")
                    {
                        <a asp-action="Feedback" asp-route-id="@Model.InterviewId" class="btn btn-primary">
                            @(Model.Feedback == null ? "Submit feedback" : "Update feedback")
                        </a>
                    }

                    @if (User.IsInRole("HR") && Model.Status == "Scheduled")
                    {
                        <form asp-action="Cancel" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.InterviewId" />
                            <button class="btn btn-outline-danger">Cancel interview</button>
                        </form>
                    }

                    @if (User.IsInRole("HR") || User.IsInRole("HiringManager"))
                    {
                        <a asp-controller="Application" asp-action="Details" asp-route-id="@Model.ApplicationId" class="btn btn-light">Application</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="content-card">
                <h5>Structured feedback</h5>
                @if (Model.Feedback == null)
                {
                    <p class="text-secondary mb-0">Feedback has not been submitted yet.</p>
                }
                else
                {
                    <div class="text-center py-3">
                        <div class="score display-5">@Model.Feedback.AverageScore / 5</div>
                        <div class="text-secondary">average score</div>
                    </div>
                    <div class="pipeline-row"><span>Technical / role</span><strong>@Model.Feedback.TechnicalScore / 5</strong></div>
                    <div class="pipeline-row"><span>Communication</span><strong>@Model.Feedback.CommunicationScore / 5</strong></div>
                    <div class="pipeline-row"><span>Problem solving</span><strong>@Model.Feedback.ProblemSolvingScore / 5</strong></div>
                    <div class="pipeline-row"><span>Culture / team fit</span><strong>@Model.Feedback.CultureFitScore / 5</strong></div>
                    <div class="pipeline-row"><span>Recommendation</span><strong>@Model.Feedback.Recommendation</strong></div>
                    <div class="mt-3"><strong>Comments</strong><p class="text-secondary mt-1 mb-0">@Model.Feedback.Comments</p></div>
                }
            </div>
        </div>
    </div>
</div>
